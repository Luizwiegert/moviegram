# Copie este arquivo para .env.local e preencha.

# Supabase: Project Settings > API (ou Data API)
# URL do projeto
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "publishable" ou "anon". NUNCA use a service_role aqui.
VITE_SUPABASE_ANON_KEY=

# TMDB (só pro script dos cartazes, não vai pro site):
# themoviedb.org > Configurações > API > "Token de leitura da API"
TMDB_TOKEN=
